# Postgres connection string, e.g.:
# local:  postgres://postgres:postgres@localhost:5432/ranger_fleet
# Render: value shown on your Postgres instance's "Internal/External Database URL"
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ranger_fleet

PORT=3000

# Set to "false" for a local Postgres that isn't configured with SSL.
# Leave as "true" (or unset) for hosted Postgres (Render, Railway, etc).
PGSSL=true
